# Qubit — environment variables. Copy to .env.local for local dev; on Vercel add them in
# Project → Settings → Environment Variables. NEVER commit real values.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.example

# ── Payments / email ────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── ALOC legacy questions API (v2) — still the default source of questions ──
ALOC_API_KEY=
# ALOC_BASE_URL=https://questions.aloc.com.ng/api/v2

# ── ALOC Station v1 (https://dev.aloc.com.ng) — OPTIONAL, off by default ────
# Your v1 key goes here (it is a different key from ALOC_API_KEY above).
ALOC_V1_API_KEY=
# ALOC_V1_BASE_URL=https://dev.aloc.com.ng/api/v1
#
# Which source students get questions from:
#   v2   (default) legacy API only — nothing changes.
#   auto  try v1 first for random-mix sets, fall back to v2 on any problem.
ALOC_PROVIDER=v2
#
# Stay under your v1 plan's requests-per-minute limit (free/developer = 30).
# Raise this after you upgrade, e.g. 120 for the Developer tier or 300 for Growth.
ALOC_V1_RATE_PER_MIN=25

# ── Android app (Play Store, Trusted Web Activity) — see docs/PLAY_STORE.md ──
# ANDROID_PACKAGE_NAME=com.yourname.qubit
# ANDROID_SHA256_FINGERPRINTS=AA:BB:...:FF   # comma separated
# NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.example
# NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=your.package.name   # shows "Get it on Google Play" on /landing
